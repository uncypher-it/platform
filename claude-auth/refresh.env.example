# Settings for the Claude OAuth refresh daemon (systemd/claude-auth-refresh.service).
# Copy to claude-auth/refresh.env (gitignored), replace DEPLOY_USER, fill in, then
#   sudo systemctl restart claude-auth-refresh.service
# Test the webhook (from the compose dir, as the deploy user):
#   (set -a; . claude-auth/refresh.env; CLAUDE_REFRESH_ALERT_TEST=1 scripts/claude-oauth-refresh-daemon.sh)

# Slack-compatible incoming webhook for auth / quota / sync alerts. Empty = alerts
# are only written to the log (journalctl) with an ALERT prefix.
ALERT_WEBHOOK_URL=
# Name used in alerts (e.g. superk-prod). Empty = the host's hostname.
ALERT_DEPLOYMENT_NAME=
# Host Claude CLI.
CLAUDE_CLI=/home/DEPLOY_USER/.local/bin/claude
# Also append the log to a file (journald always gets it).
# CLAUDE_REFRESH_LOG_FILE=/home/DEPLOY_USER/.claude/refresh.log
